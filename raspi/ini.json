{
  "url": "WebRoot/index.html",
  "port": 8080,
  "title": "Custom Browser Qt",
  "icon_path": "Assets/default.svg",
  "enable_minimize": true,
  "enable_maximize": true,
  "enable_close": true,
  "enable_move_window": true,
  "enable_kiosk_mode_toggle": true,
  "start_window_size": "1280x720",
  "start_in_kiosk": false,
  "password": "",
  "dev_tools": false,
  "extensions_enabled": false,
  "enable_autofill": true,
  "enable_password_saving": false,
  "enable_translate": true,
  "show_addressbar": false,
  "allow_tabs": false,
  "title_bar_height_px": 32,
  "title_bar_button_height_px": 24,
  "title_bar_button_width_ratio": 1.25,
  "title_bar_button_gap_px": 0,

  "system_actions_enabled": true,

  "system_action_allowed_origins": [
    "http://10.0.0.159:8082",
    "http://localhost:8080"
  ],

  "system_actions": [
    {
      "name": "restart_iobroker",
      "description": "ioBroker neu starten",
      "event": "click",
      "selector": "#restart-iobroker",
      "script": "/opt/custom-browser/scripts/restart-iobroker.sh",
      "use_sudo": true,
      "confirm": true,
      "confirm_text": "ioBroker wirklich neu starten?",
      "cooldown_ms": 5000,
      "parameter_attribute": "",
      "allowed_parameters": []
    },
    {
      "name": "restart_service",
      "description": "Einen freigegebenen Dienst neu starten",
      "event": "click",
      "selector": ".restart-service",
      "script": "/opt/custom-browser/scripts/restart-service.sh",
      "use_sudo": true,
      "confirm": true,
      "confirm_text": "Dienst wirklich neu starten?",
      "cooldown_ms": 5000,
      "parameter_attribute": "data-service",
      "allowed_parameters": [
        "iobroker",
        "nginx",
        "mariadb"
      ]
    },
    {
      "name": "restart_browser",
      "description": "Custom Browser neu starten",
      "event": "click",
      "selector": "#restart-browser",
      "script": "/opt/custom-browser/scripts/restart-browser.sh",
      "use_sudo": true,
      "confirm": true,
      "confirm_text": "Browser wirklich neu starten?",
      "cooldown_ms": 5000,
      "parameter_attribute": "",
      "allowed_parameters": []
    },
    {
      "name": "reboot_raspberry",
      "description": "Raspberry Pi neu starten",
      "event": "click",
      "selector": "#reboot-raspberry",
      "script": "/opt/custom-browser/scripts/reboot.sh",
      "use_sudo": true,
      "confirm": true,
      "confirm_text": "Raspberry Pi wirklich neu starten?",
      "cooldown_ms": 15000,
      "parameter_attribute": "",
      "allowed_parameters": []
    }
  ]
}
